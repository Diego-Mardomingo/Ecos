# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor (incluye mcp.json con tokens)
.cursor/

# secrets y tokens
*.publishable-key
*.access-token
**/secrets.json

# Serwist
public/sw*
public/swe-worker*
public/workbox-*.js

# python
__pycache__/
*.py[cod]

# lockfiles: este proyecto usa pnpm (ver packageManager)
package-lock.json

# project_overview.md
project_overview.md

# supabase: se ignora el directorio de trabajo del CLI, pero NO el esquema ni las migraciones.
# Ojo con la barra inicial: sin ella el patron tambien se comia src/lib/supabase/ y cualquier
# fichero nuevo ahi quedaba sin versionar en silencio.
/supabase/*
!/supabase/migrations/
!/supabase/schema/

# pnpm
.pnpm-store/

ECOS_CURSOR.md

# agents
.agents/

# skills
skills-lock.json